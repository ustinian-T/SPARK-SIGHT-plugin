# Volcano Ark Agent Plan — choose one compatible protocol.
LOCAL_AGENT_LLM_PROVIDER=openai
LOCAL_AGENT_LLM_PROTOCOL=responses
LOCAL_AGENT_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
LOCAL_AGENT_LLM_API_KEY=replace-with-server-side-key
LOCAL_AGENT_LLM_MODEL=ark-code-latest
LOCAL_AGENT_LLM_TIMEOUT_MS=15000

# Anthropic-compatible alternative:
# LOCAL_AGENT_LLM_PROVIDER=anthropic
# LOCAL_AGENT_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
# LOCAL_AGENT_ANTHROPIC_VERSION=2023-06-01

# Standard Ark Responses API alternative (not Agent Plan quota):
# LOCAL_AGENT_LLM_PROVIDER=openai
# LOCAL_AGENT_LLM_PROTOCOL=responses
# LOCAL_AGENT_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
