{
  "name": "@deep-imaging/local-agent",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "科研绘图辅助智能体 · 本地 Agent 服务闭环（零运行时依赖，Node 内置 HTTP + RFC6455 WebSocket + 沙箱执行 + 文件持久化 + 多轮迭代版本历史）",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "contract": "node scripts/gen-contract.mjs && node ../../apps/web/node_modules/typescript/bin/tsc -p contract/tsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "test:isolated": "node --test test/isolated-execution.test.js test/retry.test.js",
    "test:list": "node -e \"const fs=require('fs');const f=fs.readdirSync('test').filter(n=>n.endsWith('.test.js')).sort();console.log(f.length+' test files:');f.forEach(n=>console.log('  '+n))\"",
    "eval:decision": "node scripts/eval-decision.mjs",
    "eval:product": "node scripts/eval-product.mjs",
    "test:capacity:heavy": "node scripts/run-capacity-heavy.mjs",
    "smoke:matlab": "node scripts/matlab-smoke.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "UNLICENSED",
  "keywords": [
    "research-plotting",
    "agent",
    "csv",
    "chartspec",
    "local-first"
  ]
}
