{
  "name": "deep-imaging-vscode",
  "displayName": "spark sight",
  "description": "科研绘图助手：在 VS Code 中导入数据、生成和比较图表方案、审阅代码并导出可复现结果。",
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "scientific visualization",
    "charts",
    "research",
    "python",
    "data analysis"
  ],
  "homepage": "https://github.com/ustinian-T/SPARK-SIGHT-plugin#readme",
  "bugs": {
    "url": "https://github.com/ustinian-T/SPARK-SIGHT-plugin/issues"
  },
  "version": "0.1.9",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:deepImaging.open",
    "onCommand:deepImaging.startAgent",
    "onCommand:deepImaging.runMatlab",
    "onCommand:deepImaging.runCurrentFile",
    "onView:deepImaging.sidebar"
  ],
  "contributes": {
    "commands": [
      {
        "command": "deepImaging.open",
        "title": "spark sight: Open"
      },
      {
        "command": "deepImaging.startAgent",
        "title": "spark sight: Start Local Agent"
      },
      {
        "command": "deepImaging.stopAgent",
        "title": "spark sight: Stop Local Agent"
      },
      {
        "command": "deepImaging.reviewPatch",
        "title": "spark sight: Review Patch"
      },
      {
        "command": "deepImaging.openData",
        "title": "spark sight: Open CSV / Excel / JSON"
      },
      {
        "command": "deepImaging.useSelection",
        "title": "spark sight: Use Editor Selection",
        "icon": "$(insert)"
      },
      {
        "command": "deepImaging.generateVariants",
        "title": "spark sight: Generate Two Variants"
      },
      {
        "command": "deepImaging.syncProject",
        "title": "spark sight: Sync Project"
      },
      {
        "command": "deepImaging.exportAdvanced",
        "title": "spark sight: Advanced Export"
      },
      {
        "command": "deepImaging.showDiagnostics",
        "title": "spark sight: Show Diagnostics"
      },
      {
        "command": "deepImaging.generate",
        "title": "spark sight: Generate Three Plans"
      },
      {
        "command": "deepImaging.fix",
        "title": "spark sight: Fix Current Chart"
      },
      {
        "command": "deepImaging.preview",
        "title": "spark sight: Preview Chart"
      },
      {
        "command": "deepImaging.compare",
        "title": "spark sight: Compare Three Plans"
      },
      {
        "command": "deepImaging.export",
        "title": "spark sight: Export Reproducible Bundle"
      },
      {
        "command": "deepImaging.preferences",
        "title": "spark sight: Manage Preferences"
      },
      {
        "command": "deepImaging.runMatlab",
        "title": "spark sight: Run Current MATLAB Script"
      },
      {
        "command": "deepImaging.runCurrentFile",
        "title": "spark sight: Run Current Python / R / MATLAB / Node File",
        "icon": "$(play)"
      },
      {
        "command": "deepImaging.checkUpdates",
        "title": "spark sight: Check for Updates"
      },
      {
        "command": "deepImaging.openSource",
        "title": "spark sight: Open Generated Code in Editor"
      },
      {
        "command": "deepImaging.openWebsite",
        "title": "spark sight: Open Website"
      },
      {
        "command": "deepImaging.runInTerminal",
        "title": "spark sight: Run Current File in VS Code Terminal",
        "icon": "$(play)"
      }
    ],
    "keybindings": [
      {
        "command": "deepImaging.open",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i"
      },
      {
        "command": "deepImaging.openData",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      },
      {
        "command": "deepImaging.useSelection",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorHasSelection"
      },
      {
        "command": "deepImaging.generateVariants",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v"
      },
      {
        "command": "deepImaging.exportAdvanced",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "deepImaging.useSelection",
          "when": "editorHasSelection",
          "group": "navigation@9"
        }
      ],
      "explorer/context": [
        {
          "command": "deepImaging.openData",
          "when": "resourceExtname == .csv || resourceExtname == .xlsx || resourceExtname == .json",
          "group": "navigation@9"
        }
      ],
      "view/title": [
        {
          "command": "deepImaging.runInTerminal",
          "when": "view == deepImaging.sidebar",
          "group": "navigation"
        },
        {
          "command": "deepImaging.useSelection",
          "when": "view == deepImaging.sidebar",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Deep Imaging",
      "properties": {
        "deepImaging.matlabPath": {
          "type": "string",
          "default": "matlab",
          "description": "Path to a user-licensed local MATLAB executable."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sparkSight",
          "title": "spark sight",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "sparkSight": [
        {
          "type": "webview",
          "id": "deepImaging.sidebar",
          "name": "spark sight"
        }
      ]
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "vscode:prepublish": "npm --prefix ../web run build && npm run build && node scripts/prepare-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.95.0",
    "typescript": "~5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "publisher": "ustinian-T",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/ustinian-T/SPARK-SIGHT-plugin.git"
  }
}
