{
  "name": "sparksight-dsh",
  "version": "0.5.3",
  "description": "SPARK SIGHT for DeepSeek Harness: research plotting inside the agent harness",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/**",
    "THIRD_PARTY_NOTICES.md",
    "resources/**",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "prepare:package": "node scripts/prepare-dsh.mjs",
    "prepack": "node scripts/prepare-dsh.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4",
    "react": ">=18"
  },
  "author": "ustinian-T",
  "license": "MIT",
  "homepage": "https://www.example.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ustinian-T/SPARK-SIGHT-plugin.git",
    "directory": "apps/dsh"
  },
  "bugs": {
    "url": "https://github.com/ustinian-T/SPARK-SIGHT-plugin/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "sparksight",
    "research-plotting",
    "charts",
    "figure"
  ]
}
