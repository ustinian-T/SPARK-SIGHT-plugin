{
  "name": "sparksight-dsh",
  "version": "0.4.1",
  "description": "SPARK SIGHT for DeepSeek Harness: research plotting inside the agent harness",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "THIRD_PARTY_NOTICES.md",
    "resources/**",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "prepare:package": "node scripts/prepare-dsh.mjs",
    "prepack": "node scripts/prepare-dsh.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4",
    "react": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "sparksight",
    "research-plotting",
    "charts",
    "figure"
  ]
}
