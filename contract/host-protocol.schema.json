{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deep Imaging Host Protocol v2",
  "protocolVersion": 2,
  "messageTypes": ["agent.config", "diff.open", "selection.read", "patch.apply", "patch.applyHunks", "plans.compare", "text.insert", "diagnostic.reveal", "edit.undo", "handoff.write", "runtime.capabilities", "runtime.runMatlab", "runtime.discover", "runtime.plan", "runtime.run", "runtime.events", "runtime.cancel", "runtime.openArtifact"],
  "agentStates": ["INGEST", "UNDERSTAND", "NEED_INPUT", "PLAN", "ANALYZE", "DESIGN", "EXECUTE", "VERIFY", "REPAIR", "FAILED", "PRESENT", "ITERATE", "COMPLETE", "CANCELLED"],
  "backendErrorCodes": [
    "UNAUTHORIZED", "FORBIDDEN", "PROTOCOL_MISMATCH", "NOT_FOUND", "TASK_NOT_FOUND", "METHOD_NOT_ALLOWED", "BAD_REQUEST",
    "AUTH_INVALID", "AUTH_CONFLICT", "AUTH_FAILED", "PROJECT_NOT_FOUND", "LOCK_INVALID", "CLOUD_NOT_CONFIGURED",
    "CLOUD_SYNC_FAILED", "SYNC_CONFLICT", "SHARE_NOT_FOUND",
    "MISSING_FILE", "EMPTY_FILE", "INVALID_CSV", "BINARY_CONTENT", "ENCODING_UNSUPPORTED", "NOT_TABULAR",
    "NO_DATA_ROWS", "DUPLICATE_HEADER", "NO_NUMERIC_FIELDS", "INVALID_JSON", "UNSUPPORTED_DATA_FORMAT",
    "XLSX_INVALID", "XLSX_UNSAFE", "XLSX_MACRO", "XLSX_EXTERNAL_LINK", "XLSX_ENCRYPTED", "BUNDLE_FILE_COUNT",
    "RECOMMENDATION_NOT_FOUND", "RECOMMENDATION_STALE", "RECOMMENDATION_CONFLICT",
    "INVALID_ENGINE", "UNKNOWN_FIELD", "CLAIM_UNVERIFIED",
    "INSUFFICIENT_CANDIDATES", "TASK_NOT_WAITING", "TASK_TERMINAL", "TASK_BUSY", "TASK_CANCELLED",
    "SOURCE_INVALID", "SOURCE_STALE", "SOURCE_TOKEN_INVALID", "SOURCE_TOKEN_EXPIRED", "STRONG_SANDBOX_REQUIRED",
    "DATA_REVISION_INVALID", "DATA_REVISION_STALE", "DATA_TOKEN_INVALID", "DATA_TOKEN_EXPIRED", "DATA_CONFIRMATION_REQUIRED",
    "SESSION_INVALID", "SESSION_EXPIRED", "RATE_LIMITED", "QUOTA_EXCEEDED",
    "UPLOAD_NOT_FOUND", "UPLOAD_OFFSET_MISMATCH", "UPLOAD_INCOMPLETE", "SIGNED_URL_INVALID", "SIGNED_URL_EXPIRED",
    "SANDBOX_EXECUTION_FAILED", "PLAN_NOT_FOUND", "PATCH_INVALID", "PATCH_TARGET_NOT_FOUND", "PATCH_TOKEN_INVALID",
    "PATCH_TOKEN_EXPIRED", "PATCH_STALE", "REVISION_NOT_FOUND", "PATH_OUTSIDE_TASK", "ARTIFACT_NOT_FOUND", "PAYLOAD_TOO_LARGE",
    "UNSUPPORTED_MEDIA_TYPE", "PLUGIN_INVALID", "MERGE_INVALID", "COMMENT_INVALID", "COMMENT_NOT_FOUND",
    "SIGNIFICANCE_INVALID", "REMOTE_NODE_INVALID", "REMOTE_NODE_NOT_FOUND", "REMOTE_NODE_UNAVAILABLE", "INTERNAL"
  ],
  "hostErrorCodes": [
    "HOST_PROTOCOL_MISMATCH", "HOST_MESSAGE_INVALID", "HOST_RESPONSE_INVALID", "HOST_RESPONSE_MISMATCH",
    "HOST_REQUEST_FAILED", "HOST_UNAVAILABLE", "WORKSPACE_UNTRUSTED", "RESOURCE_NOT_ALLOWED", "AGENT_UNAVAILABLE",
    "PATCH_BASE_STALE", "PATCH_HUNK_INVALID", "PATCH_HUNK_OVERLAP", "PLAN_COMPARISON_INVALID", "MATLAB_UNAVAILABLE",
    "RUNTIME_NOT_FOUND", "RUNTIME_UNAVAILABLE", "RUNTIME_PLAN_REJECTED", "RUNTIME_PATH_UNSAFE",
    "RUNTIME_CANCELLED", "RUNTIME_NOT_RUNNING", "ARTIFACT_NOT_FOUND", "ARTIFACT_PATH_UNSAFE",
    "RUNTIME_EXECUTION_FAILED"
  ],
  "requiredExportContents": [
    "plot.py", "plot.R", "plot.m", "data.csv", "ChartSpec.json", "evidence.json", "evidence.md", "README.txt", "artifacts/"
  ],
  "message": {
    "required": ["version", "id", "type", "payload"],
    "additionalProperties": false
  },
  "response": {
    "required": ["version", "id", "ok"],
    "additionalProperties": false
  }
}
